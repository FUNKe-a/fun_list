<!doctype html>
<html lang='en'>
    <head>
        <meta charset='utf-8'>
        <title>Register</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <script defer src="/static/js/htmx.min.js"></script>
    </head>
    <body>
		<h1>Comments</h1>
		<form hx-post="/api/comments" hx-target="#comments" hx-swap="afterbegin">
			<input name="rating" type="text" placeholder="rating" />
			<input name="content" type="text" placeholder="content" />
			<input name="media_id" type="text" placeholder="media_id" />
			<button type="submit">Submit</button>
		</form>
		<ul id="comments"
		hx-get="/api/comments"
		hx-vals='{"media_id": "1", "start_key": 10, "page_size": 5}' 
		hx-trigger="load">
		</ul>
    </body>
</html>
